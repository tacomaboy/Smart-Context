# Copy to .env and adjust. All values are optional; defaults shown.

# prune  = filter oversized tool results in the newest turn (default)
# shadow = measure only, never modify a request
SMARTCONTEXT_MODE=prune

SMARTCONTEXT_HOST=127.0.0.1
SMARTCONTEXT_PORT=4711
SMARTCONTEXT_UPSTREAM=https://api.anthropic.com

# Blocks smaller than this are never touched -- the risk isn't worth the tokens.
SMARTCONTEXT_MIN_BLOCK_CHARS=4000
# Target size for the kept portion of a filtered block.
SMARTCONTEXT_KEEP_BUDGET_CHARS=1500
SMARTCONTEXT_CHUNK_CHARS=900

SMARTCONTEXT_LOCAL_MODEL=gemma3:12b
# Leave unset to try the usage dashboard on :4700, then Ollama on :11434.
# SMARTCONTEXT_OLLAMA_BASE=http://localhost:11434

# Optional: trim oversized tools catalogs (for MCP-heavy clients).
SMARTCONTEXT_TRIM_TOOLS=false
SMARTCONTEXT_MAX_TOOLS=64

# SMARTCONTEXT_DATA_DIR=%USERPROFILE%\\.smartcontext
